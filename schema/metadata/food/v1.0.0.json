{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fbs-community.example/metadata/food/v1.0.0.json",
  "title": "FBS Food Product Metadata Schema v1.0.0",
  "description": "Domain-specific metadata schema for food products. Incorporates the FBS Core Metadata Schema via allOf to ensure all core interoperability fields are present. Defined in RFC FBS0001 Section 4.2.4.4.",
  "allOf": [
    {
      "$ref": "https://schemas.fbs-community.example/metadata/core/v1.0.0.json"
    }
  ],
  "required": ["name", "languages", "ingredients"],
  "properties": {
    "servingSize": {
      "type": "string",
      "description": "Serving size as a human-readable string with units. Examples: '40g', '1 cup (240ml)', '100ml'."
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Ordered list of ingredients, from most to least predominant by weight."
    },
    "allergens": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "gluten",
          "crustaceans",
          "eggs",
          "fish",
          "peanuts",
          "soy",
          "milk",
          "nuts",
          "celery",
          "mustard",
          "sesame",
          "sulphites",
          "lupin",
          "molluscs"
        ]
      },
      "description": "List of declared allergens present in the product. Uses EU Regulation 1169/2011 allergen identifiers."
    },
    "storageInstructions": {
      "type": "string",
      "maxLength": 1000,
      "description": "Instructions for proper storage and handling of the product."
    },
    "preparationInstructions": {
      "type": "string",
      "maxLength": 2000,
      "description": "Instructions for preparation, cooking, or use of the product."
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "issuer"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the certification (e.g., 'Organic', 'Fair Trade', 'Kosher', 'Halal')"
          },
          "issuer": {
            "type": "string",
            "description": "Organization or body that issued the certification"
          },
          "certificationUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "description": "HTTPS URL for verification of the certification"
          }
        },
        "additionalProperties": false
      },
      "description": "Array of certifications held by this product (organic, fair trade, etc.)"
    },
    "expiryDate": {
      "type": "string",
      "format": "date",
      "description": "Expected shelf-life expiry date in ISO 8601 format (YYYY-MM-DD). Note: individual items may vary."
    },
    "nutritionFacts": {
      "type": "object",
      "description": "Nutrition facts with normalized units. Legacy numeric values are accepted for compatibility and imply the historical default unit documented for each field.",
      "properties": {
        "measurementBasis": {
          "type": "string",
          "enum": ["per_serving", "per_100g", "per_100ml"],
          "description": "Declares what quantity the nutrition values are based on. Use per_serving unless local labeling regulations require otherwise."
        },
        "countryCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "Optional ISO 3166-1 alpha-2 country code indicating the market this panel applies to (for example, US, CA, GB, DE)."
        },
        "regulatoryStandard": {
          "type": "string",
          "enum": ["US-FDA", "EU-FIC-1169", "CA-HC", "AU-NZ-FSANZ", "OTHER"],
          "description": "Optional nutrition labeling standard used to produce this panel."
        },
        "calories": {
          "$ref": "#/$defs/nutritionEnergy"
        },
        "fat": {
          "$ref": "#/$defs/nutritionMassGrams"
        },
        "saturatedFat": {
          "$ref": "#/$defs/nutritionMassGrams"
        },
        "transFat": {
          "$ref": "#/$defs/nutritionMassGrams"
        },
        "cholesterol": {
          "$ref": "#/$defs/nutritionMassMilligrams"
        },
        "sodium": {
          "$ref": "#/$defs/nutritionMassMilligrams"
        },
        "carbohydrates": {
          "$ref": "#/$defs/nutritionMassGrams"
        },
        "fiber": {
          "$ref": "#/$defs/nutritionMassGrams"
        },
        "sugars": {
          "$ref": "#/$defs/nutritionMassGrams"
        },
        "addedSugars": {
          "$ref": "#/$defs/nutritionMassGrams"
        },
        "protein": {
          "$ref": "#/$defs/nutritionMassGrams"
        },
        "potassium": {
          "$ref": "#/$defs/nutritionMassMilligrams"
        },
        "vitaminA": {
          "$ref": "#/$defs/nutritionMicronutrientLabelValue"
        },
        "vitaminC": {
          "$ref": "#/$defs/nutritionMicronutrientLabelValue"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "nutritionEnergy": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "description": "Legacy format. Interpreted as kilocalories (kcal)."
        },
        {
          "type": "object",
          "required": ["value", "unit"],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "type": "string",
              "enum": ["kcal", "kJ"]
            }
          },
          "additionalProperties": false,
          "description": "Normalized format for energy values."
        }
      ]
    },
    "nutritionMassGrams": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0,
          "description": "Legacy format. Interpreted as grams (g)."
        },
        {
          "type": "object",
          "required": ["value", "unit"],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "type": "string",
              "enum": ["g"]
            }
          },
          "additionalProperties": false,
          "description": "Normalized format for macronutrient mass values."
        }
      ]
    },
    "nutritionMassMilligrams": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0,
          "description": "Legacy format. Interpreted as milligrams (mg)."
        },
        {
          "type": "object",
          "required": ["value", "unit"],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "type": "string",
              "enum": ["mg"]
            }
          },
          "additionalProperties": false,
          "description": "Normalized format for micronutrient mass values."
        }
      ]
    },
    "nutritionMicronutrientLabelValue": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0,
          "description": "Legacy format. Interpreted as percent daily value."
        },
        {
          "type": "object",
          "required": ["value", "unit"],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "type": "string",
              "enum": ["percent_dv", "mg", "mcg"]
            }
          },
          "additionalProperties": false,
          "description": "Normalized format for micronutrient label values, supporting percent daily value and absolute units for country-specific nutrition panels."
        }
      ]
    }
  },
  "additionalProperties": true
}
