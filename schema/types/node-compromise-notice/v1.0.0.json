{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fbs-community.example/types/node-compromise-notice/v1.0.0.json",
  "title": "FBS Node Compromise Notice v1.0.0",
  "description": "Notice that a node's key has been compromised and records after a given time should not be trusted. RFC FBS0001 Section 4.4.3.",
  "type": "object",
  "required": [
    "type",
    "affectedNodeId",
    "affectedKeyFingerprint",
    "compromisedAfter",
    "newPublicKey",
    "notice",
    "publishedBy"
  ],
  "properties": {
    "type": {"type": "string", "enum": ["NodeCompromiseNotice"], "description": "Object type discriminator"},
    "affectedNodeId": {"type": "string", "format": "uri", "pattern": "^https://", "description": "HTTPS URL of the compromised node"},
    "affectedKeyFingerprint": {"type": "string", "pattern": "^sha256:", "description": "Fingerprint of the compromised key"},
    "compromisedAfter": {"type": "string", "format": "date-time", "description": "Timestamp after which records may be untrustworthy"},
    "newPublicKey": {"$ref": "#/$defs/Ed25519PublicKey", "description": "Replacement public key for the node"},
    "notice": {"type": "string", "description": "Human-readable explanation of the compromise"},
    "publishedBy": {"type": "string", "pattern": "^fbs://", "description": "AID of the entity publishing this notice"}
  },
  "additionalProperties": false,
  "$defs": {
    "Ed25519PublicKey": {
      "type": "object",
      "required": ["algorithm", "publicKeyPem"],
      "properties": {
        "algorithm": {"type": "string", "enum": ["Ed25519"], "description": "Key algorithm"},
        "publicKeyPem": {"type": "string", "description": "PEM-encoded public key"}
      },
      "additionalProperties": false
    }
  }
}